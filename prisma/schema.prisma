generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANISER
  ATTENDEE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BookingStatus {
  PENDING // seats are locked, waiting for payment
  CONFIRMED // paid, tickets issued
  CANCELLED // payment failed/timed out, or cancelled by the user
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ATTENDEE)
  createdAt    DateTime  @default(now())
  events       Event[]
  bookings     Booking[]
}

model Event {
  id          String      @id @default(uuid())
  organiserId String
  organiser   User        @relation(fields: [organiserId], references: [id])
  title       String
  description String      @default("")
  venue       String
  startsAt    DateTime
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  seats       Seat[]
  bookings    Booking[]

  @@index([status, startsAt])
}

model Seat {
  id           String        @id @default(uuid())
  eventId      String
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  row          String
  number       Int
  tier         String
  /// Price in minor units (paise/cents) to avoid floating point money.
  price        Int
  bookingSeats BookingSeat[]
  tickets      Ticket[]

  @@unique([eventId, row, number])
}

model Booking {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id])
  status         BookingStatus @default(PENDING)
  /// Computed server-side from seat prices, in minor units.
  totalAmount    Int
  idempotencyKey String
  holdId         String
  paymentId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  seats          BookingSeat[]
  tickets        Ticket[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

/// Join table between a booking and its seats.
///
/// The final safety net against double booking lives in the migration SQL:
///   CREATE UNIQUE INDEX ... ON "BookingSeat"("seatId") WHERE "active";
/// i.e. a seat can appear in at most ONE active (pending or confirmed) booking.
/// Prisma's schema language can't express partial indexes, hence the raw SQL.
model BookingSeat {
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatId    String
  seat      Seat    @relation(fields: [seatId], references: [id])
  eventId   String
  /// true while the booking is PENDING or CONFIRMED; false once CANCELLED.
  active    Boolean @default(true)

  @@id([bookingId, seatId])
  @@index([eventId, active])
}

model Ticket {
  /// Generated by the app (not the DB) so it can be embedded in the signed qrToken.
  id          String    @id
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatId      String
  seat        Seat      @relation(fields: [seatId], references: [id])
  qrToken     String    @unique
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([bookingId])
}
