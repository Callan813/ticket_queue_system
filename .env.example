# Copy to .env for local development (`npm run dev`). Docker Compose sets its own values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/ticketing
REDIS_URL=redis://localhost:6379/0

# Each secret must be at least 32 characters.
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=1h
QR_SECRET=dev-qr-secret-change-me-0123456789abcdefgh
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me-0123456789ab

# Booking rules
HOLD_TTL_SECONDS=300
MAX_SEATS_PER_HOLD=10
PAYMENT_TIMEOUT_SECONDS=600

# Rate limits (requests per window, per IP for auth / per user for holds & bookings)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_BOOKING_MAX=30
RATE_LIMIT_BOOKING_WINDOW_SECONDS=60

RUN_WORKER=true
MOCK_PAYMENTS_ENABLED=true
SEED_ON_START=false
